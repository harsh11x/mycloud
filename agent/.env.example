[TEMPLATE]
# Copy to agent/.local/agent.env (gitignored) and run with it loaded. Never commit real values.

# Listen address. Keep on loopback and expose it only through Cloudflare Tunnel.
AGENT_LISTEN=127.0.0.1:8787

# Base64 Ed25519 PUBLIC key that matches the web app's GRANT_SIGNING_KEY. No private key here.
AGENT_PUBKEY=<BASE64_ED25519_PUBLIC_KEY>

# Comma-separated storage roots on this machine. Use a dedicated directory the agent user owns.
AGENT_ROOTS=<ABSOLUTE_STORAGE_ROOT_PATH>

# Only web origin allowed to call the agent from a browser.
AGENT_ALLOW_ORIGIN=https://<YOUR_APP_DOMAIN>
