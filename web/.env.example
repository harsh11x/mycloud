[TEMPLATE]
# Copy to .env (local) or set in the Vercel project settings. Never commit real values.

# Postgres connection string (hosted Postgres in production, use sslmode=require).
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# Public origin of this web app. Mutating requests must come from this origin.
APP_ORIGIN=https://<YOUR_APP_DOMAIN>

# Ed25519 private key (PEM) used ONLY to sign upload/download grants. Server-side only.
# Single line with literal \n for newlines.
GRANT_SIGNING_KEY=<ED25519_PRIVATE_KEY_PEM_SINGLE_LINE>

# Public HTTPS URL of the Storage Agent (Cloudflare Tunnel).
AGENT_URL=https://<YOUR_AGENT_DOMAIN>
